# 运行时数据（含主密钥、管理员密码、加密凭据库），绝不入库
data/

# 数据备份（含加密凭据库），绝不入库
data.bak.*/

# 本地配置（含密钥/密码）；模板见 .env.example
.env
.env.local

# 运行日志
*.log

# 构建产物
server-agent-link
*.exe
*.test
/dist/
/bin/

# 编辑器 / 系统杂项
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# 内部/个人文档（不进仓库；项目手册 使用说明.md 仍保留跟踪）
docs/superpowers/
docs/GIT_PROXY_SETUP.md
