# ServerAgentLink 环境配置示例。复制为 .env 后按需修改。
# 规则：真实环境变量优先于 .env；两者都不设置时使用默认值。
# 密码/密钥等值含 # 或空格时请用双引号包裹。

# 监听地址（默认 :8080）
SAL_LISTEN_ADDR=:8080

# 数据目录：SQLite + master.key + admin-password.txt（默认 ./data）
SAL_DATA_DIR=./data

# MCP 端点静态 Bearer token（必填，agent 接入时用）；生产务必改成随机强值
SAL_MCP_TOKEN=change-me-to-a-random-token

# 管理员用户名（默认 admin）
SAL_ADMIN_USER=admin

# 首次运行的管理员密码；留空则自动生成随机密码写入 data/admin-password.txt（0600）
#SAL_ADMIN_PASSWORD=

# 主密钥（32 字节 hex）；留空则自动生成到 data/master.key（0600）。
# 一旦写入数据必须保持不变，丢失则库内密码永久不可解密。
#SAL_MASTER_KEY=

# TLS（可选，成对设置；设置后监听 HTTPS 且会话 cookie 带 Secure）
#SAL_TLS_CERT=/path/to/cert.pem
#SAL_TLS_KEY=/path/to/key.pem
